{% assign sid = block.id | replace: '_', '' | downcase %}
{% assign layout = block.settings.layout %}
{% assign msg1 = block.settings.message_1 %}
{% assign msg2 = block.settings.message_2 %}
{% assign msg3 = block.settings.message_3 %}
{% assign msg4 = block.settings.message_4 %}
{% assign brand = block.settings.brand_text %}

{% if block.settings.link != blank %}
  <a href="{{ block.settings.link }}" class="ss-ann ss-ann-{{ sid }} ss-ann--{{ layout }}">
{% else %}
  <div class="ss-ann ss-ann-{{ sid }} ss-ann--{{ layout }}">
{% endif %}

  {% if layout == 'marquee' %}
    <div class="ss-ann-track">
      {% for i in (1..2) %}
        <div class="ss-ann-row">
          {% if brand != blank %}<strong>{{ brand }}</strong><span>•</span>{% endif %}
          {% if msg1 != blank %}<b>{{ msg1 }}</b><span>•</span>{% endif %}
          {% if brand != blank %}<strong>{{ brand }}</strong><span>•</span>{% endif %}
          {% if msg2 != blank %}<b>{{ msg2 }}</b><span>•</span>{% endif %}
          {% if brand != blank %}<strong>{{ brand }}</strong><span>•</span>{% endif %}
          {% if msg3 != blank %}<b>{{ msg3 }}</b><span>•</span>{% endif %}
          {% if msg4 != blank %}<b>{{ msg4 }}</b><span>•</span>{% endif %}
        </div>
      {% endfor %}
    </div>

  {% elsif layout == 'center' %}
    <div class="ss-ann-center">
      {% if brand != blank %}<strong>{{ brand }}</strong>{% endif %}
      {% if msg1 != blank %}<span>{{ msg1 }}</span>{% endif %}
    </div>

  {% else %}
    <div class="ss-ann-pills">
      {% if msg1 != blank %}<span>{{ msg1 }}</span>{% endif %}
      {% if msg2 != blank %}<span>{{ msg2 }}</span>{% endif %}
      {% if msg3 != blank %}<span>{{ msg3 }}</span>{% endif %}
    </div>
  {% endif %}

{% if block.settings.link != blank %}
  </a>
{% else %}
  </div>
{% endif %}

<style>
.ss-ann-{{ sid }}{
  --bg:{{ block.settings.bg }};
  --txt:{{ block.settings.text }};
  --accent:{{ block.settings.accent }};
  --h:{{ block.settings.height }}px;
  --fs:{{ block.settings.font_size }}px;
  display:block;
  width:100%;
  min-height:var(--h);
  background:var(--bg);
  color:var(--txt);
  text-decoration:none;
  overflow:hidden;
  font-size:var(--fs);
  line-height:1.2;
}
.ss-ann-{{ sid }} *{box-sizing:border-box}
.ss-ann-{{ sid }} strong{
  font-size:calc(var(--fs) + 12px);
  font-weight:900;
  letter-spacing:-.04em;
  color:var(--txt);
  white-space:nowrap;
}
.ss-ann-{{ sid }} b{
  font-weight:800;
  white-space:nowrap;
  color:var(--txt);
}
.ss-ann-{{ sid }} span{
  color:var(--txt);
  opacity:.95;
  white-space:nowrap;
}
.ss-ann-{{ sid }}.ss-ann--marquee{
  display:flex;
  align-items:center;
}
.ss-ann-{{ sid }} .ss-ann-track{
  display:flex;
  width:max-content;
  animation:ssAnn{{ sid }} {{ block.settings.speed }}s linear infinite;
}
.ss-ann-{{ sid }} .ss-ann-row{
  display:flex;
  align-items:center;
  gap:34px;
  padding-right:34px;
  min-width:max-content;
}
.ss-ann-{{ sid }}.ss-ann--center{
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:10px 18px;
}
.ss-ann-{{ sid }} .ss-ann-center{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:12px;
  flex-wrap:wrap;
  font-weight:800;
}
.ss-ann-{{ sid }}.ss-ann--pills{
  display:flex;
  align-items:center;
  justify-content:center;
  padding:10px 14px;
}
.ss-ann-{{ sid }} .ss-ann-pills{
  display:flex;
  gap:10px;
  align-items:center;
  justify-content:center;
  flex-wrap:wrap;
}
.ss-ann-{{ sid }} .ss-ann-pills span{
  padding:8px 13px;
  border-radius:999px;
  background:var(--accent);
  font-weight:850;
}
@keyframes ssAnn{{ sid }}{
  from{transform:translateX(0)}
  to{transform:translateX(-50%)}
}
@media(max-width:749px){
  .ss-ann-{{ sid }}{--h:{{ block.settings.mobile_height }}px;--fs:{{ block.settings.mobile_font_size }}px}
  .ss-ann-{{ sid }} strong{font-size:calc(var(--fs) + 8px)}
  .ss-ann-{{ sid }} .ss-ann-row{gap:22px;padding-right:22px}
}
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Design style",
      "default": "marquee",
      "options": [
        { "value": "marquee", "label": "Moving logo strip" },
        { "value": "center", "label": "Centered premium bar" },
        { "value": "pills", "label": "Pill highlights" }
      ]
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "Restofit"
    },
    {
      "type": "text",
      "id": "message_1",
      "label": "Message 1",
      "default": "Orthopedic Mattress India"
    },
    {
      "type": "text",
      "id": "message_2",
      "label": "Message 2",
      "default": "Premium Mattress in India"
    },
    {
      "type": "text",
      "id": "message_3",
      "label": "Message 3",
      "default": "Memory Foam Mattress India"
    },
    {
      "type": "text",
      "id": "message_4",
      "label": "Message 4",
      "default": "Best Mattress for Back Pain"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#3A084E"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Pill background",
      "default": "#5B136F"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 36,
      "max": 90,
      "step": 2,
      "default": 62
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 32,
      "max": 80,
      "step": 2,
      "default": 50
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop text size",
      "min": 10,
      "max": 22,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile text size",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 13
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Marquee speed",
      "min": 8,
      "max": 40,
      "step": 1,
      "default": 22
    }
  ]
}
{% endschema %}