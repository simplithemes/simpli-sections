{% assign uid = block.id | replace: '-', '_' %}

<section class="ss-ba ss-ba-{{ uid }}">
  <div class="ss-ba__inner">
    <div class="ss-ba__header">
      <span>{{ block.settings.badge }}</span>
      <h2>{{ block.settings.heading }}</h2>
      <p>{{ block.settings.subheading }}</p>
    </div>

    <div class="ss-ba__slider" style="--position: 50%;">
      {% if block.settings.before_image != blank %}
        <img class="ss-ba__before" src="{{ block.settings.before_image | image_url: width: 1100 }}" alt="Before" loading="lazy">
      {% endif %}

      {% if block.settings.after_image != blank %}
        <img class="ss-ba__after" src="{{ block.settings.after_image | image_url: width: 1100 }}" alt="After" loading="lazy">
      {% endif %}

      <div class="ss-ba__line"></div>
      <input type="range" min="0" max="100" value="50" class="ss-ba__range">
      <span class="ss-ba__label ss-ba__label-before">{{ block.settings.before_label }}</span>
      <span class="ss-ba__label ss-ba__label-after">{{ block.settings.after_label }}</span>
    </div>
  </div>
</section>

<style>
  .ss-ba-{{ uid }} {
    background: {{ block.settings.background }};
    padding: {{ block.settings.padding }}px 16px;
  }

  .ss-ba-{{ uid }} .ss-ba__inner {
    max-width: 980px;
    margin: 0 auto;
  }

  .ss-ba-{{ uid }} .ss-ba__header {
    text-align: center;
    margin-bottom: 28px;
  }

  .ss-ba-{{ uid }} .ss-ba__header span {
    display: inline-block;
    background: {{ block.settings.badge_bg }};
    color: {{ block.settings.accent }};
    padding: 7px 13px;
    border-radius: 999px;
    font-weight: 900;
    font-size: 13px;
    margin-bottom: 14px;
  }

  .ss-ba-{{ uid }} h2 {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: clamp(30px, 4vw, 48px);
    letter-spacing: -0.05em;
    line-height: 1.05;
  }

  .ss-ba-{{ uid }} p {
    color: {{ block.settings.text_color }};
    margin: 12px 0 0;
  }

  .ss-ba-{{ uid }} .ss-ba__slider {
    position: relative;
    min-height: 520px;
    border-radius: {{ block.settings.radius }}px;
    overflow: hidden;
    background: #e5e7eb;
    box-shadow: 0 24px 70px rgba(15,23,42,0.12);
  }

  .ss-ba-{{ uid }} .ss-ba__before,
  .ss-ba-{{ uid }} .ss-ba__after {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ss-ba-{{ uid }} .ss-ba__after {
    clip-path: inset(0 0 0 var(--position));
  }

  .ss-ba-{{ uid }} .ss-ba__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--position);
    width: 3px;
    background: #fff;
    transform: translateX(-50%);
    z-index: 2;
  }

  .ss-ba-{{ uid }} .ss-ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    z-index: 3;
  }

  .ss-ba-{{ uid }} .ss-ba__label {
    position: absolute;
    top: 16px;
    z-index: 4;
    background: rgba(255,255,255,0.9);
    color: #101828;
    border-radius: 999px;
    padding: 8px 13px;
    font-weight: 900;
    font-size: 13px;
  }

  .ss-ba-{{ uid }} .ss-ba__label-before {
    left: 16px;
  }

  .ss-ba-{{ uid }} .ss-ba__label-after {
    right: 16px;
  }

  @media(max-width: 749px) {
    .ss-ba-{{ uid }} .ss-ba__slider {
      min-height: 360px;
    }
  }
</style>

<script>
  (function () {
    const section = document.querySelector('.ss-ba-{{ uid }}');
    if (!section) return;

    const slider = section.querySelector('.ss-ba__slider');
    const range = section.querySelector('.ss-ba__range');

    range.addEventListener('input', function () {
      slider.style.setProperty('--position', range.value + '%');
    });
  })();
</script>

{% schema %}
{
  "name": "Before After Slider",
  "target": "section",
  "settings": [
    { "type": "image_picker", "id": "before_image", "label": "Before image" },
    { "type": "image_picker", "id": "after_image", "label": "After image" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "See the difference" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before & after results" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Show transformation, results, comparison or product impact." },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#101828" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#667085" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3A084E" },
    { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#F3E8FF" },
    { "type": "range", "id": "radius", "label": "Image radius", "min": 8, "max": 40, "step": 1, "default": 28 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 24, "max": 120, "step": 4, "default": 64 }
  ]
}
{% endschema %}