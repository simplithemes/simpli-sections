{% liquid
  assign sid = block.id | replace: '_', ''
%}

<div class="ss-ba ss-ba-{{ sid }}" {{ block.shopify_attributes }}>
  <div class="ss-ba__wrap">
    {% if block.settings.heading != blank %}
      <h2>{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <p class="ss-ba__sub">{{ block.settings.subheading }}</p>
    {% endif %}

    <div class="ss-ba__box" style="--pos:{{ block.settings.start_position }}%">
      {% if block.settings.before_image %}
        <img class="ss-ba__img" src="{{ block.settings.before_image | image_url: width: 1400 }}" alt="{{ block.settings.before_label | escape }}">
      {% endif %}

      {% if block.settings.after_image %}
        <div class="ss-ba__after">
          <img class="ss-ba__img" src="{{ block.settings.after_image | image_url: width: 1400 }}" alt="{{ block.settings.after_label | escape }}">
        </div>
      {% endif %}

      <span class="ss-ba__label ss-ba__label--before">{{ block.settings.before_label }}</span>
      <span class="ss-ba__label ss-ba__label--after">{{ block.settings.after_label }}</span>

      <input class="ss-ba__range" type="range" min="0" max="100" value="{{ block.settings.start_position }}" aria-label="Before after slider">
      <span class="ss-ba__line"></span>
      <span class="ss-ba__handle">↔</span>
    </div>
  </div>
</div>

<script>
(() => {
  const root = document.querySelector('.ss-ba-{{ sid }}');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';

  const box = root.querySelector('.ss-ba__box');
  const range = root.querySelector('.ss-ba__range');

  if (!box || !range) return;

  range.addEventListener('input', () => {
    box.style.setProperty('--pos', range.value + '%');
  });
})();
</script>

<style>
.ss-ba-{{ sid }}{
  padding:{{ block.settings.pad_y }}px 16px;
  background:{{ block.settings.bg }};
  color:{{ block.settings.text_color }};
}
.ss-ba-{{ sid }} .ss-ba__wrap{
  max-width:{{ block.settings.width }}px;
  margin:auto;
  text-align:{{ block.settings.align }};
}
.ss-ba-{{ sid }} h2{
  margin:0 0 8px;
  font-size:clamp(24px,3.5vw,{{ block.settings.heading_size }}px);
  line-height:1.12;
  color:inherit;
}
.ss-ba-{{ sid }} .ss-ba__sub{
  margin:0 auto 22px;
  max-width:680px;
  font-size:15px;
  line-height:1.5;
  opacity:.7;
}
.ss-ba-{{ sid }} .ss-ba__box{
  position:relative;
  overflow:hidden;
  border-radius:{{ block.settings.radius }}px;
  background:#f4f4f4;
  aspect-ratio:{{ block.settings.aspect_ratio }};
  box-shadow:0 18px 45px rgba(0,0,0,.08);
  border:1px solid {{ block.settings.border }};
}
.ss-ba-{{ sid }} .ss-ba__img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}
.ss-ba-{{ sid }} .ss-ba__after{
  position:absolute;
  inset:0;
  width:var(--pos);
  overflow:hidden;
}
.ss-ba-{{ sid }} .ss-ba__after .ss-ba__img{
  width:calc(100% / (var(--pos) / 100));
  max-width:none;
}
.ss-ba-{{ sid }} .ss-ba__range{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  opacity:0;
  cursor:ew-resize;
  z-index:4;
}
.ss-ba-{{ sid }} .ss-ba__line{
  position:absolute;
  top:0;
  bottom:0;
  left:var(--pos);
  width:2px;
  background:#fff;
  transform:translateX(-50%);
  z-index:2;
  box-shadow:0 0 0 1px rgba(0,0,0,.08);
}
.ss-ba-{{ sid }} .ss-ba__handle{
  position:absolute;
  left:var(--pos);
  top:50%;
  transform:translate(-50%,-50%);
  width:46px;
  height:46px;
  border-radius:50%;
  background:{{ block.settings.handle_bg }};
  color:{{ block.settings.handle_color }};
  display:grid;
  place-items:center;
  font-size:18px;
  font-weight:800;
  z-index:3;
  box-shadow:0 8px 24px rgba(0,0,0,.18);
}
.ss-ba-{{ sid }} .ss-ba__label{
  position:absolute;
  top:14px;
  z-index:3;
  padding:6px 11px;
  border-radius:999px;
  background:{{ block.settings.label_bg }};
  color:{{ block.settings.label_color }};
  font-size:12px;
  font-weight:800;
  letter-spacing:.02em;
}
.ss-ba-{{ sid }} .ss-ba__label--before{left:14px}
.ss-ba-{{ sid }} .ss-ba__label--after{right:14px}
@media(max-width:749px){
  .ss-ba-{{ sid }}{
    padding:{{ block.settings.mobile_pad_y }}px 14px;
  }
  .ss-ba-{{ sid }} .ss-ba__box{
    aspect-ratio:{{ block.settings.mobile_aspect_ratio }};
  }
  .ss-ba-{{ sid }} .ss-ba__handle{
    width:40px;
    height:40px;
    font-size:16px;
  }
}
</style>

{% schema %}
{
  "name": "SS Before After Slider",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See the difference"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Drag the slider to compare before and after results."
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Desktop image ratio",
      "default": "16/9",
      "options": [
        { "value": "16/9", "label": "Landscape" },
        { "value": "4/3", "label": "Classic" },
        { "value": "1/1", "label": "Square" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_aspect_ratio",
      "label": "Mobile image ratio",
      "default": "4/5",
      "options": [
        { "value": "4/5", "label": "Portrait" },
        { "value": "1/1", "label": "Square" },
        { "value": "16/9", "label": "Landscape" }
      ]
    },
    {
      "type": "range",
      "id": "start_position",
      "label": "Initial slider position",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 50
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#151515"
    },
    {
      "type": "color",
      "id": "border",
      "label": "Border",
      "default": "#eee7da"
    },
    {
      "type": "color",
      "id": "handle_bg",
      "label": "Handle background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "handle_color",
      "label": "Handle icon",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "label_bg",
      "label": "Label background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 48,
      "step": 1,
      "default": 34
    },
    {
      "type": "range",
      "id": "pad_y",
      "label": "Desktop vertical padding",
      "min": 24,
      "max": 100,
      "step": 2,
      "default": 52
    },
    {
      "type": "range",
      "id": "mobile_pad_y",
      "label": "Mobile vertical padding",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 36
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Image radius",
      "min": 6,
      "max": 32,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "width",
      "label": "Content width",
      "min": 700,
      "max": 1400,
      "step": 50,
      "default": 1000
    }
  ]
}
{% endschema %}