{% liquid
  assign sid = block.id | replace: '_', ''
%}

<div class="ss-bb ss-bb-{{ sid }}" {{ block.shopify_attributes }}>
  <div class="ss-bb__wrap">

    {% if block.settings.heading != blank %}
      <h2>{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ss-bb__items">
      {% for product in block.settings.products limit: 3 %}
        <div class="ss-bb__item">
          <img src="{{ product.featured_image | image_url: width: 300 }}">
          <div>
            <strong>{{ product.title }}</strong>
            <span>{{ product.price | money }}</span>
          </div>
        </div>
      {% endfor %}
    </div>

    <button class="ss-bb__btn">
      {{ block.settings.button_text }}
    </button>

  </div>
</div>

<style>
.ss-bb-{{ sid }}{
  padding:{{ block.settings.pad }}px 16px;
  background:{{ block.settings.bg }};
}
.ss-bb-{{ sid }} .ss-bb__wrap{
  max-width:{{ block.settings.width }}px;
  margin:auto;
}
.ss-bb-{{ sid }} h2{
  margin:0 0 16px;
  font-size:clamp(22px,3vw,{{ block.settings.heading_size }}px);
}
.ss-bb-{{ sid }} .ss-bb__items{
  display:grid;
  gap:12px;
}
.ss-bb-{{ sid }} .ss-bb__item{
  display:flex;
  gap:10px;
  align-items:center;
}
.ss-bb-{{ sid }} img{
  width:60px;
  height:60px;
  object-fit:cover;
  border-radius:10px;
}
.ss-bb-{{ sid }} button{
  margin-top:14px;
  padding:12px;
  width:100%;
  background:#111;
  color:#fff;
  border:0;
  border-radius:10px;
  font-weight:700;
}
</style>

{% schema %}
{
  "name": "SS Bundle Builder",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bundle & Save"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Bundle products",
      "limit": 3
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Add bundle to cart"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 22,
      "max": 40,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
      "id": "pad",
      "label": "Padding",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "width",
      "label": "Content width",
      "min": 900,
      "max": 1400,
      "step": 50,
      "default": 1200
    }
  ]
}
{% endschema %}