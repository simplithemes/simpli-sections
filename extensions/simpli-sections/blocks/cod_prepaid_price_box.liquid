{% assign uid = block.id | replace: '-', '_' %}

<section class="ss-cod-prepaid ss-cod-prepaid-{{ uid }}">
  <div class="ss-cod-prepaid__box">
    <div class="ss-cod-prepaid__header">
      <span>{{ block.settings.badge }}</span>
      <h2>{{ block.settings.heading }}</h2>
      <p>{{ block.settings.subheading }}</p>
    </div>

    <div class="ss-cod-prepaid__grid">
      <div class="ss-cod-prepaid__card">
        <small>{{ block.settings.cod_label }}</small>
        <strong>{{ block.settings.cod_price }}</strong>
        <p>{{ block.settings.cod_text }}</p>
      </div>

      <div class="ss-cod-prepaid__card ss-cod-prepaid__highlight">
        <small>{{ block.settings.prepaid_label }}</small>
        <strong>{{ block.settings.prepaid_price }}</strong>
        <p>{{ block.settings.prepaid_text }}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .ss-cod-prepaid-{{ uid }} {
    background: {{ block.settings.background }};
    padding: {{ block.settings.padding }}px 16px;
  }

  .ss-cod-prepaid-{{ uid }} .ss-cod-prepaid__box {
    max-width: 860px;
    margin: 0 auto;
    background: {{ block.settings.card_bg }};
    border-radius: {{ block.settings.radius }}px;
    padding: 30px;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 24px 70px rgba(15,23,42,0.1);
  }

  .ss-cod-prepaid-{{ uid }} .ss-cod-prepaid__header {
    text-align: center;
    margin-bottom: 24px;
  }

  .ss-cod-prepaid-{{ uid }} span {
    display: inline-block;
    background: {{ block.settings.badge_bg }};
    color: {{ block.settings.accent }};
    padding: 7px 13px;
    border-radius: 999px;
    font-weight: 900;
    font-size: 13px;
    margin-bottom: 14px;
  }

  .ss-cod-prepaid-{{ uid }} h2 {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .ss-cod-prepaid-{{ uid }} .ss-cod-prepaid__header p {
    color: {{ block.settings.text_color }};
    margin: 12px 0 0;
  }

  .ss-cod-prepaid-{{ uid }} .ss-cod-prepaid__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .ss-cod-prepaid-{{ uid }} .ss-cod-prepaid__card {
    background: {{ block.settings.option_bg }};
    border-radius: 22px;
    padding: 22px;
    text-align: center;
    border: 2px solid transparent;
  }

  .ss-cod-prepaid-{{ uid }} .ss-cod-prepaid__highlight {
    border-color: {{ block.settings.accent }};
    background: {{ block.settings.highlight_bg }};
  }

  .ss-cod-prepaid-{{ uid }} small {
    display: block;
    color: {{ block.settings.text_color }};
    font-weight: 900;
    margin-bottom: 8px;
  }

  .ss-cod-prepaid-{{ uid }} strong {
    display: block;
    color: {{ block.settings.heading_color }};
    font-size: 34px;
    letter-spacing: -0.05em;
  }

  .ss-cod-prepaid-{{ uid }} .ss-cod-prepaid__highlight strong {
    color: {{ block.settings.accent }};
  }

  .ss-cod-prepaid-{{ uid }} .ss-cod-prepaid__card p {
    color: {{ block.settings.text_color }};
    margin: 8px 0 0;
    line-height: 1.5;
  }

  @media(max-width: 749px) {
    .ss-cod-prepaid-{{ uid }} .ss-cod-prepaid__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "COD Prepaid Price Box",
  "target": "section",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "Payment offer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Save more with prepaid payment" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Compare COD and prepaid value clearly." },
    { "type": "text", "id": "cod_label", "label": "COD label", "default": "Cash on Delivery" },
    { "type": "text", "id": "cod_price", "label": "COD price", "default": "₹999" },
    { "type": "text", "id": "cod_text", "label": "COD text", "default": "Standard price for pay later orders." },
    { "type": "text", "id": "prepaid_label", "label": "Prepaid label", "default": "Online Payment" },
    { "type": "text", "id": "prepaid_price", "label": "Prepaid price", "default": "₹899" },
    { "type": "text", "id": "prepaid_text", "label": "Prepaid text", "default": "Best value when you pay via UPI/Card/Netbanking." },
    { "type": "color", "id": "background", "label": "Background", "default": "#F8FAFC" },
    { "type": "color", "id": "card_bg", "label": "Main card background", "default": "#FFFFFF" },
    { "type": "color", "id": "option_bg", "label": "Option background", "default": "#F8FAFC" },
    { "type": "color", "id": "highlight_bg", "label": "Highlight background", "default": "#FAF5FF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#101828" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#667085" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3A084E" },
    { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#F3E8FF" },
    { "type": "range", "id": "radius", "label": "Radius", "min": 12, "max": 40, "step": 1, "default": 28 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 24, "max": 120, "step": 4, "default": 64 }
  ]
}
{% endschema %}