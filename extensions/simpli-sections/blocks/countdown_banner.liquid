{% assign uid = block.id | replace: '-', '_' %}

<section class="ss-countdown ss-countdown-{{ uid }}" data-end-date="{{ block.settings.end_date }}">
  <div class="ss-countdown__inner">
    <div>
      {% if block.settings.badge != blank %}
        <span>{{ block.settings.badge }}</span>
      {% endif %}
      <h2>{{ block.settings.heading }}</h2>
      <p>{{ block.settings.subheading }}</p>
    </div>

    <div class="ss-countdown__timer">
      <div><strong data-days>00</strong><small>Days</small></div>
      <div><strong data-hours>00</strong><small>Hours</small></div>
      <div><strong data-minutes>00</strong><small>Mins</small></div>
      <div><strong data-seconds>00</strong><small>Secs</small></div>
    </div>
  </div>
</section>

<style>
  .ss-countdown-{{ uid }} {
    background: {{ block.settings.background }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding }}px 16px;
  }

  .ss-countdown-{{ uid }} .ss-countdown__inner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: center;
  }

  .ss-countdown-{{ uid }} span {
    display: inline-block;
    background: {{ block.settings.badge_bg }};
    color: {{ block.settings.badge_color }};
    padding: 7px 13px;
    border-radius: 999px;
    font-weight: 900;
    font-size: 13px;
    margin-bottom: 12px;
  }

  .ss-countdown-{{ uid }} h2 {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .ss-countdown-{{ uid }} p {
    margin: 12px 0 0;
    color: {{ block.settings.text_color }};
  }

  .ss-countdown-{{ uid }} .ss-countdown__timer {
    display: grid;
    grid-template-columns: repeat(4, 82px);
    gap: 10px;
  }

  .ss-countdown-{{ uid }} .ss-countdown__timer div {
    background: {{ block.settings.box_bg }};
    border-radius: {{ block.settings.radius }}px;
    padding: 14px 10px;
    text-align: center;
  }

  .ss-countdown-{{ uid }} strong {
    display: block;
    color: {{ block.settings.heading_color }};
    font-size: 26px;
    line-height: 1;
  }

  .ss-countdown-{{ uid }} small {
    display: block;
    color: {{ block.settings.text_color }};
    margin-top: 6px;
    font-size: 12px;
    font-weight: 700;
  }

  @media(max-width: 749px) {
    .ss-countdown-{{ uid }} .ss-countdown__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .ss-countdown-{{ uid }} .ss-countdown__timer {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

<script>
  (function () {
    const section = document.querySelector('.ss-countdown-{{ uid }}');
    if (!section) return;

    const endDate = new Date(section.dataset.endDate).getTime();
    const days = section.querySelector('[data-days]');
    const hours = section.querySelector('[data-hours]');
    const minutes = section.querySelector('[data-minutes]');
    const seconds = section.querySelector('[data-seconds]');

    function pad(num) {
      return String(num).padStart(2, '0');
    }

    function updateCountdown() {
      const now = new Date().getTime();
      const distance = endDate - now;

      if (distance <= 0 || Number.isNaN(endDate)) {
        days.textContent = '00';
        hours.textContent = '00';
        minutes.textContent = '00';
        seconds.textContent = '00';
        return;
      }

      days.textContent = pad(Math.floor(distance / (1000 * 60 * 60 * 24)));
      hours.textContent = pad(Math.floor((distance / (1000 * 60 * 60)) % 24));
      minutes.textContent = pad(Math.floor((distance / (1000 * 60)) % 60));
      seconds.textContent = pad(Math.floor((distance / 1000) % 60));
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);
  })();
</script>

{% schema %}
{
  "name": "Countdown Banner",
  "target": "section",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "Limited time" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sale ends soon" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Create urgency with a clean countdown banner." },
    { "type": "text", "id": "end_date", "label": "End date/time", "default": "2026-12-31T23:59:59" },
    { "type": "color_background", "id": "background", "label": "Background", "default": "linear-gradient(135deg, #101828, #3A084E)" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#E5E7EB" },
    { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#FFFFFF" },
    { "type": "color", "id": "badge_color", "label": "Badge text color", "default": "#3A084E" },
    { "type": "color", "id": "box_bg", "label": "Timer box background", "default": "rgba(255,255,255,0.12)" },
    { "type": "range", "id": "radius", "label": "Box radius", "min": 8, "max": 28, "step": 1, "default": 18 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 24, "max": 100, "step": 4, "default": 48 }
  ]
}
{% endschema %}