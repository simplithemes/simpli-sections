{% assign uid = block.id | replace: '-', '_' %}

<section class="ss-ship-pro ss-ship-pro-{{ uid }}">
  <div class="ss-ship-pro__inner">
    <span>{{ block.settings.icon }}</span>
    <div>
      <strong>{{ block.settings.heading }}</strong>
      <p>{{ block.settings.text }}</p>
    </div>

    {% if block.settings.button_text != blank and block.settings.button_link != blank %}
      <a href="{{ block.settings.button_link }}">{{ block.settings.button_text }}</a>
    {% endif %}
  </div>
</section>

<style>
  .ss-ship-pro-{{ uid }} {
    background: {{ block.settings.background }};
    padding: {{ block.settings.padding }}px 16px;
  }

  .ss-ship-pro-{{ uid }} .ss-ship-pro__inner {
    max-width: 980px;
    margin: 0 auto;
    background: {{ block.settings.card_bg }};
    border-radius: {{ block.settings.radius }}px;
    padding: 18px;
    display: grid;
    grid-template-columns: 52px 1fr auto;
    gap: 16px;
    align-items: center;
    box-shadow: 0 18px 50px rgba(15,23,42,0.08);
    border: 1px solid rgba(0,0,0,0.08);
  }

  .ss-ship-pro-{{ uid }} span {
    width: 52px;
    height: 52px;
    border-radius: 18px;
    background: {{ block.settings.icon_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
  }

  .ss-ship-pro-{{ uid }} strong {
    display: block;
    color: {{ block.settings.heading_color }};
    font-size: 18px;
  }

  .ss-ship-pro-{{ uid }} p {
    color: {{ block.settings.text_color }};
    margin: 4px 0 0;
  }

  .ss-ship-pro-{{ uid }} a {
    background: {{ block.settings.button_bg }};
    color: {{ block.settings.button_color }};
    text-decoration: none;
    border-radius: 999px;
    padding: 12px 18px;
    font-weight: 900;
    white-space: nowrap;
  }

  @media(max-width: 749px) {
    .ss-ship-pro-{{ uid }} .ss-ship-pro__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .ss-ship-pro-{{ uid }} span {
      margin: 0 auto;
    }
  }
</style>

{% schema %}
{
  "name": "Free Shipping Bar Pro",
  "target": "section",
  "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "🚚" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Free shipping on prepaid orders" },
    { "type": "text", "id": "text", "label": "Text", "default": "A premium shipping message bar to increase checkout confidence." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#F8FAFC" },
    { "type": "color", "id": "icon_bg", "label": "Icon background", "default": "#F3E8FF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#101828" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#667085" },
    { "type": "color_background", "id": "button_bg", "label": "Button background", "default": "linear-gradient(135deg, #101828, #3A084E)" },
    { "type": "color", "id": "button_color", "label": "Button text color", "default": "#FFFFFF" },
    { "type": "range", "id": "radius", "label": "Radius", "min": 10, "max": 36, "step": 1, "default": 24 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 16, "max": 80, "step": 4, "default": 32 }
  ]
}
{% endschema %}