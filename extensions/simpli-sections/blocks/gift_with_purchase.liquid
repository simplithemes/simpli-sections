{% assign uid = block.id | replace: '-', '_' %}
{% assign product = block.settings.product %}

<section class="ss-gwp ss-gwp-{{ uid }}">
  <div class="ss-gwp__box">
    <div class="ss-gwp__media">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" loading="lazy">
      {% endif %}
    </div>

    <div class="ss-gwp__content">
      <span>{{ block.settings.badge }}</span>
      <h2>{{ block.settings.heading }}</h2>
      <p>{{ block.settings.text }}</p>

      {% if product != blank %}
        <strong>{{ product.title }}</strong>
      {% endif %}

      <small>{{ block.settings.note }}</small>
    </div>
  </div>
</section>

<style>
  .ss-gwp-{{ uid }} {
    background: {{ block.settings.background }};
    padding: {{ block.settings.padding }}px 16px;
  }

  .ss-gwp-{{ uid }} .ss-gwp__box {
    max-width: 980px;
    margin: 0 auto;
    background: {{ block.settings.card_bg }};
    border-radius: {{ block.settings.radius }}px;
    padding: 24px;
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 24px;
    align-items: center;
    box-shadow: 0 24px 70px rgba(15,23,42,0.1);
    border: 1px solid rgba(0,0,0,0.08);
  }

  .ss-gwp-{{ uid }} .ss-gwp__media {
    background: {{ block.settings.image_bg }};
    border-radius: 22px;
    min-height: 240px;
    overflow: hidden;
  }

  .ss-gwp-{{ uid }} img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
  }

  .ss-gwp-{{ uid }} span {
    display: inline-block;
    background: {{ block.settings.badge_bg }};
    color: {{ block.settings.accent }};
    padding: 7px 13px;
    border-radius: 999px;
    font-weight: 900;
    font-size: 13px;
    margin-bottom: 14px;
  }

  .ss-gwp-{{ uid }} h2 {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .ss-gwp-{{ uid }} p {
    color: {{ block.settings.text_color }};
    margin: 14px 0;
    line-height: 1.7;
  }

  .ss-gwp-{{ uid }} strong {
    display: block;
    color: {{ block.settings.accent }};
    font-size: 18px;
    margin-bottom: 10px;
  }

  .ss-gwp-{{ uid }} small {
    display: block;
    color: {{ block.settings.text_color }};
    font-weight: 700;
  }

  @media(max-width: 749px) {
    .ss-gwp-{{ uid }} .ss-gwp__box {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "Gift With Purchase",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Gift product" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Free gift" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get a free gift with your order" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Show a premium gift-with-purchase offer to increase conversion and cart value." },
    { "type": "text", "id": "note", "label": "Note", "default": "Gift eligibility can be managed through your store offer rules." },
    { "type": "color", "id": "background", "label": "Background", "default": "#F8FAFC" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "image_bg", "label": "Image background", "default": "#F3E8FF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#101828" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#667085" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3A084E" },
    { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#F3E8FF" },
    { "type": "range", "id": "radius", "label": "Radius", "min": 12, "max": 40, "step": 1, "default": 28 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 24, "max": 120, "step": 4, "default": 64 }
  ]
}
{% endschema %}