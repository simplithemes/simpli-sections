{% assign uid = block.id | replace: '-', '_' %}

<section class="ss-image-text ss-image-text-{{ uid }}">
  <div class="ss-image-text__inner {% if block.settings.image_position == 'right' %}ss-image-text__reverse{% endif %}">
    <div class="ss-image-text__media">
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.heading | escape }}" loading="lazy">
      {% endif %}
    </div>

    <div class="ss-image-text__content">
      {% if block.settings.badge != blank %}
        <span>{{ block.settings.badge }}</span>
      {% endif %}

      <h2>{{ block.settings.heading }}</h2>
      <p>{{ block.settings.text }}</p>

      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
        <a href="{{ block.settings.button_link }}">{{ block.settings.button_text }}</a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .ss-image-text-{{ uid }} {
    background: {{ block.settings.background }};
    padding: {{ block.settings.padding }}px 16px;
  }

  .ss-image-text-{{ uid }} .ss-image-text__inner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 38px;
    align-items: center;
  }

  .ss-image-text-{{ uid }} .ss-image-text__reverse .ss-image-text__media {
    order: 2;
  }

  .ss-image-text-{{ uid }} .ss-image-text__media {
    border-radius: {{ block.settings.radius }}px;
    overflow: hidden;
    background: #f1f5f9;
  }

  .ss-image-text-{{ uid }} img {
    width: 100%;
    min-height: 420px;
    object-fit: cover;
    display: block;
  }

  .ss-image-text-{{ uid }} span {
    display: inline-block;
    background: {{ block.settings.badge_bg }};
    color: {{ block.settings.accent }};
    padding: 7px 13px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 13px;
    margin-bottom: 14px;
  }

  .ss-image-text-{{ uid }} h2 {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: clamp(32px, 5vw, 54px);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .ss-image-text-{{ uid }} p {
    color: {{ block.settings.text_color }};
    font-size: 17px;
    line-height: 1.7;
    margin: 18px 0 24px;
  }

  .ss-image-text-{{ uid }} a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.button_bg }};
    color: {{ block.settings.button_color }};
    padding: 14px 22px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 900;
  }

  @media(max-width: 749px) {
    .ss-image-text-{{ uid }} .ss-image-text__inner {
      grid-template-columns: 1fr;
    }

    .ss-image-text-{{ uid }} .ss-image-text__reverse .ss-image-text__media {
      order: 0;
    }

    .ss-image-text-{{ uid }} img {
      min-height: 320px;
    }
  }
</style>

{% schema %}
{
  "name": "Image Text",
  "target": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Premium section" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell your brand story beautifully" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Use this section to explain product benefits, brand story, ingredients, craftsmanship, or any important message." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Explore now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#101828" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#667085" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3A084E" },
    { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#F3E8FF" },
    { "type": "color_background", "id": "button_bg", "label": "Button background", "default": "linear-gradient(135deg, #101828, #3A084E)" },
    { "type": "color", "id": "button_color", "label": "Button text color", "default": "#FFFFFF" },
    { "type": "range", "id": "radius", "label": "Image radius", "min": 8, "max": 40, "step": 1, "default": 28 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 24, "max": 120, "step": 4, "default": 64 }
  ]
}
{% endschema %}