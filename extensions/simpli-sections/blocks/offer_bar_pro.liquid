{% assign uid = block.id | replace: '-', '_' %}

<section class="ss-offer-pro ss-offer-pro-{{ uid }}">
  <div class="ss-offer-pro__inner">
    <div>
      <span>{{ block.settings.badge }}</span>
      <strong>{{ block.settings.heading }}</strong>
      <p>{{ block.settings.text }}</p>
    </div>

    {% if block.settings.button_text != blank and block.settings.button_link != blank %}
      <a href="{{ block.settings.button_link }}">{{ block.settings.button_text }}</a>
    {% endif %}
  </div>
</section>

<style>
  .ss-offer-pro-{{ uid }} {
    background: {{ block.settings.background }};
    padding: {{ block.settings.padding }}px 16px;
  }

  .ss-offer-pro-{{ uid }} .ss-offer-pro__inner {
    max-width: 1180px;
    margin: 0 auto;
    background: {{ block.settings.card_bg }};
    border-radius: {{ block.settings.radius }}px;
    padding: 24px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 18px;
    align-items: center;
    box-shadow: 0 24px 70px rgba(15,23,42,0.12);
    border: 1px solid rgba(255,255,255,0.22);
  }

  .ss-offer-pro-{{ uid }} span {
    display: inline-block;
    background: {{ block.settings.badge_bg }};
    color: {{ block.settings.badge_color }};
    padding: 7px 13px;
    border-radius: 999px;
    font-weight: 900;
    font-size: 13px;
    margin-bottom: 12px;
  }

  .ss-offer-pro-{{ uid }} strong {
    display: block;
    color: {{ block.settings.heading_color }};
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .ss-offer-pro-{{ uid }} p {
    color: {{ block.settings.text_color }};
    margin: 10px 0 0;
    line-height: 1.5;
  }

  .ss-offer-pro-{{ uid }} a {
    background: {{ block.settings.button_bg }};
    color: {{ block.settings.button_color }};
    text-decoration: none;
    border-radius: 999px;
    padding: 14px 22px;
    font-weight: 900;
    white-space: nowrap;
  }

  @media(max-width: 749px) {
    .ss-offer-pro-{{ uid }} .ss-offer-pro__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "Offer Bar Pro",
  "target": "section",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "Limited offer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Unlock exclusive savings today" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Use this premium offer bar for campaigns, sales, coupons or launch announcements." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Claim offer" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color_background", "id": "card_bg", "label": "Offer background", "default": "linear-gradient(135deg, #101828, #3A084E)" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#E5E7EB" },
    { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#FFFFFF" },
    { "type": "color", "id": "badge_color", "label": "Badge text color", "default": "#3A084E" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#FFFFFF" },
    { "type": "color", "id": "button_color", "label": "Button text color", "default": "#101828" },
    { "type": "range", "id": "radius", "label": "Radius", "min": 12, "max": 40, "step": 1, "default": 28 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 16, "max": 80, "step": 4, "default": 32 }
  ]
}
{% endschema %}