{% assign uid = block.id | replace: '-', '_' %}

<section class="ss-pin ss-pin-{{ uid }}">
  <div class="ss-pin__box">
    <div>
      <span>{{ block.settings.badge }}</span>
      <h2>{{ block.settings.heading }}</h2>
      <p>{{ block.settings.subheading }}</p>
    </div>

    <div class="ss-pin__form">
      <input type="text" maxlength="10" placeholder="{{ block.settings.placeholder }}">
      <button type="button">{{ block.settings.button_text }}</button>
    </div>

    <div class="ss-pin__result"></div>
  </div>
</section>

<style>
  .ss-pin-{{ uid }} {
    background: {{ block.settings.background }};
    padding: {{ block.settings.padding }}px 16px;
  }

  .ss-pin-{{ uid }} .ss-pin__box {
    max-width: 760px;
    margin: 0 auto;
    background: {{ block.settings.card_bg }};
    border-radius: {{ block.settings.radius }}px;
    padding: 30px;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 22px 60px rgba(15,23,42,0.09);
    text-align: center;
  }

  .ss-pin-{{ uid }} span {
    display: inline-block;
    background: {{ block.settings.badge_bg }};
    color: {{ block.settings.accent }};
    padding: 7px 13px;
    border-radius: 999px;
    font-weight: 900;
    font-size: 13px;
    margin-bottom: 14px;
  }

  .ss-pin-{{ uid }} h2 {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: clamp(28px, 4vw, 42px);
    letter-spacing: -0.04em;
  }

  .ss-pin-{{ uid }} p {
    color: {{ block.settings.text_color }};
    margin: 12px 0 22px;
  }

  .ss-pin-{{ uid }} .ss-pin__form {
    display: flex;
    gap: 10px;
  }

  .ss-pin-{{ uid }} input {
    flex: 1;
    border: 1px solid rgba(0,0,0,0.14);
    border-radius: 999px;
    padding: 15px 18px;
    font-size: 15px;
  }

  .ss-pin-{{ uid }} button {
    border: 0;
    border-radius: 999px;
    padding: 15px 22px;
    background: {{ block.settings.button_bg }};
    color: {{ block.settings.button_color }};
    font-weight: 900;
    cursor: pointer;
  }

  .ss-pin-{{ uid }} .ss-pin__result {
    margin-top: 16px;
    font-weight: 800;
    color: {{ block.settings.result_color }};
  }

  @media(max-width: 749px) {
    .ss-pin-{{ uid }} .ss-pin__form {
      flex-direction: column;
    }
  }
</style>

<script>
  (function () {
    const section = document.querySelector('.ss-pin-{{ uid }}');
    if (!section) return;

    const input = section.querySelector('input');
    const button = section.querySelector('button');
    const result = section.querySelector('.ss-pin__result');

    button.addEventListener('click', function () {
      const value = input.value.trim();

      if (value.length < 4) {
        result.textContent = '{{ block.settings.error_text }}';
        return;
      }

      result.textContent = '{{ block.settings.success_text }}'.replace('[pin]', value);
    });
  })();
</script>

{% schema %}
{
  "name": "Pincode Checker",
  "target": "section",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "Delivery check" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Check delivery availability" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Let customers check estimated delivery before checkout." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter pincode / ZIP code" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Check" },
    { "type": "text", "id": "success_text", "label": "Success text", "default": "Good news! Delivery is available for [pin]." },
    { "type": "text", "id": "error_text", "label": "Error text", "default": "Please enter a valid pincode or ZIP code." },
    { "type": "color", "id": "background", "label": "Background", "default": "#F8FAFC" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#101828" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#667085" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3A084E" },
    { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#F3E8FF" },
    { "type": "color_background", "id": "button_bg", "label": "Button background", "default": "linear-gradient(135deg, #101828, #3A084E)" },
    { "type": "color", "id": "button_color", "label": "Button text color", "default": "#FFFFFF" },
    { "type": "color", "id": "result_color", "label": "Result color", "default": "#15803D" },
    { "type": "range", "id": "radius", "label": "Radius", "min": 10, "max": 36, "step": 1, "default": 24 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 24, "max": 120, "step": 4, "default": 64 }
  ]
}
{% endschema %}