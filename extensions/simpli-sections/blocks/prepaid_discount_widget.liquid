{% assign uid = block.id | replace: '-', '_' %}

<section class="ss-prepaid ss-prepaid-{{ uid }}">
  <div class="ss-prepaid__box">
    <div class="ss-prepaid__icon">{{ block.settings.icon }}</div>
    <div>
      <h3>{{ block.settings.heading }}</h3>
      <p>{{ block.settings.text }}</p>
      <strong>{{ block.settings.highlight }}</strong>
    </div>
  </div>
</section>

<style>
  .ss-prepaid-{{ uid }} {
    background: {{ block.settings.background }};
    padding: {{ block.settings.padding }}px 16px;
  }

  .ss-prepaid-{{ uid }} .ss-prepaid__box {
    max-width: 760px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 16px;
    align-items: center;
    background: {{ block.settings.card_bg }};
    border-radius: {{ block.settings.radius }}px;
    padding: 22px;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 18px 50px rgba(15,23,42,0.08);
  }

  .ss-prepaid-{{ uid }} .ss-prepaid__icon {
    width: 54px;
    height: 54px;
    border-radius: 18px;
    background: {{ block.settings.icon_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
  }

  .ss-prepaid-{{ uid }} h3 {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: 22px;
    letter-spacing: -0.03em;
  }

  .ss-prepaid-{{ uid }} p {
    margin: 6px 0;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
  }

  .ss-prepaid-{{ uid }} strong {
    color: {{ block.settings.accent }};
    font-size: 16px;
  }

  @media(max-width: 749px) {
    .ss-prepaid-{{ uid }} .ss-prepaid__box {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .ss-prepaid-{{ uid }} .ss-prepaid__icon {
      margin: 0 auto;
    }
  }
</style>

{% schema %}
{
  "name": "Prepaid Discount Widget",
  "target": "section",
  "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "💳" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pay online and save extra" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Encourage customers to choose prepaid payment with a clear benefit message." },
    { "type": "text", "id": "highlight", "label": "Highlight text", "default": "Extra savings available on prepaid orders" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#F8FAFC" },
    { "type": "color", "id": "icon_bg", "label": "Icon background", "default": "#F3E8FF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#101828" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#667085" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3A084E" },
    { "type": "range", "id": "radius", "label": "Radius", "min": 10, "max": 36, "step": 1, "default": 24 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 16, "max": 80, "step": 4, "default": 32 }
  ]
}
{% endschema %}