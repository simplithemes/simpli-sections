{% assign uid = block.id | replace: '-', '_' %}

<section class="ss-highlights ss-highlights-{{ uid }}">
  <div class="ss-highlights__inner">
    <div class="ss-highlights__media">
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.heading | escape }}" loading="lazy">
      {% endif %}
    </div>

    <div class="ss-highlights__content">
      <span>{{ block.settings.badge }}</span>
      <h2>{{ block.settings.heading }}</h2>
      <p>{{ block.settings.text }}</p>

      <div class="ss-highlights__grid">
        <div><strong>{{ block.settings.title_1 }}</strong><p>{{ block.settings.desc_1 }}</p></div>
        <div><strong>{{ block.settings.title_2 }}</strong><p>{{ block.settings.desc_2 }}</p></div>
        <div><strong>{{ block.settings.title_3 }}</strong><p>{{ block.settings.desc_3 }}</p></div>
        <div><strong>{{ block.settings.title_4 }}</strong><p>{{ block.settings.desc_4 }}</p></div>
      </div>
    </div>
  </div>
</section>

<style>
  .ss-highlights-{{ uid }} {
    background: {{ block.settings.background }};
    padding: {{ block.settings.padding }}px 16px;
  }

  .ss-highlights-{{ uid }} .ss-highlights__inner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
    align-items: center;
  }

  .ss-highlights-{{ uid }} .ss-highlights__media {
    border-radius: {{ block.settings.radius }}px;
    overflow: hidden;
    background: #eef2f7;
    min-height: 420px;
  }

  .ss-highlights-{{ uid }} img {
    width: 100%;
    height: 100%;
    min-height: 420px;
    object-fit: cover;
    display: block;
  }

  .ss-highlights-{{ uid }} span {
    display: inline-block;
    background: {{ block.settings.badge_bg }};
    color: {{ block.settings.accent }};
    border-radius: 999px;
    padding: 7px 13px;
    font-weight: 800;
    font-size: 13px;
    margin-bottom: 14px;
  }

  .ss-highlights-{{ uid }} h2 {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: clamp(32px, 5vw, 54px);
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .ss-highlights-{{ uid }} .ss-highlights__content > p {
    color: {{ block.settings.text_color }};
    font-size: 17px;
    line-height: 1.7;
    margin: 18px 0 24px;
  }

  .ss-highlights-{{ uid }} .ss-highlights__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .ss-highlights-{{ uid }} .ss-highlights__grid div {
    background: {{ block.settings.card_bg }};
    border-radius: 18px;
    padding: 18px;
    border: 1px solid rgba(0,0,0,0.08);
  }

  .ss-highlights-{{ uid }} strong {
    color: {{ block.settings.heading_color }};
  }

  .ss-highlights-{{ uid }} .ss-highlights__grid p {
    color: {{ block.settings.text_color }};
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.5;
  }

  @media(max-width: 749px) {
    .ss-highlights-{{ uid }} .ss-highlights__inner,
    .ss-highlights-{{ uid }} .ss-highlights__grid {
      grid-template-columns: 1fr;
    }

    .ss-highlights-{{ uid }} .ss-highlights__media,
    .ss-highlights-{{ uid }} img {
      min-height: 320px;
    }
  }
</style>

{% schema %}
{
  "name": "Product Highlights",
  "target": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Why customers love it" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Designed for better everyday use" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Highlight the most important product benefits in a clean, premium layout." },
    { "type": "text", "id": "title_1", "label": "Highlight 1 title", "default": "Premium Quality" },
    { "type": "text", "id": "desc_1", "label": "Highlight 1 text", "default": "Built with attention to detail." },
    { "type": "text", "id": "title_2", "label": "Highlight 2 title", "default": "Easy to Use" },
    { "type": "text", "id": "desc_2", "label": "Highlight 2 text", "default": "Simple and customer friendly." },
    { "type": "text", "id": "title_3", "label": "Highlight 3 title", "default": "Fast Delivery" },
    { "type": "text", "id": "desc_3", "label": "Highlight 3 text", "default": "Ships quickly across regions." },
    { "type": "text", "id": "title_4", "label": "Highlight 4 title", "default": "Trusted Choice" },
    { "type": "text", "id": "desc_4", "label": "Highlight 4 text", "default": "Loved by real customers." },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#F8FAFC" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#101828" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#667085" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3A084E" },
    { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#F3E8FF" },
    { "type": "range", "id": "radius", "label": "Image radius", "min": 8, "max": 40, "step": 1, "default": 28 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 24, "max": 120, "step": 4, "default": 64 }
  ]
}
{% endschema %}