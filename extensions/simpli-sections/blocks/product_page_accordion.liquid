{% liquid
  assign sid = block.id | replace: '_', ''
%}

<div class="ss-acc ss-acc-{{ sid }}" {{ block.shopify_attributes }}>
  <div class="ss-acc__wrap">
    {% if block.settings.heading != blank %}
      <h2>{{ block.settings.heading }}</h2>
    {% endif %}

    {% for i in (1..6) %}
      {% assign title_key = 'title_' | append: i %}
      {% assign body_key = 'body_' | append: i %}
      {% assign title = block.settings[title_key] %}
      {% assign body = block.settings[body_key] %}

      {% if title != blank and body != blank %}
        <details class="ss-acc__item" {% if forloop.first and block.settings.first_open %}open{% endif %}>
          <summary>
            <span>{{ title }}</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </summary>
          <div class="ss-acc__body">{{ body }}</div>
        </details>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
.ss-acc-{{ sid }}{
  background:{{ block.settings.bg }};
  color:{{ block.settings.text_color }};
  padding:{{ block.settings.pad_y }}px 16px;
}
.ss-acc-{{ sid }} .ss-acc__wrap{
  max-width:{{ block.settings.width }}px;
  margin:auto;
}
.ss-acc-{{ sid }} h2{
  margin:0 0 18px;
  font-size:clamp(22px,3vw,{{ block.settings.heading_size }}px);
  line-height:1.2;
  color:inherit;
}
.ss-acc-{{ sid }} .ss-acc__item{
  border:1px solid {{ block.settings.border }};
  border-radius:{{ block.settings.radius }}px;
  background:{{ block.settings.card_bg }};
  margin-bottom:10px;
  overflow:hidden;
}
.ss-acc-{{ sid }} summary{
  cursor:pointer;
  list-style:none;
  min-height:54px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
  padding:0 18px;
  font-weight:700;
  font-size:15px;
}
.ss-acc-{{ sid }} summary::-webkit-details-marker{display:none}
.ss-acc-{{ sid }} svg{
  width:18px;
  height:18px;
  flex:0 0 18px;
  transition:transform .2s ease;
}
.ss-acc-{{ sid }} details[open] svg{transform:rotate(180deg)}
.ss-acc-{{ sid }} .ss-acc__body{
  padding:0 18px 18px;
  font-size:14px;
  line-height:1.65;
  opacity:.78;
}
.ss-acc-{{ sid }} .ss-acc__body p{margin:0 0 10px}
.ss-acc-{{ sid }} .ss-acc__body p:last-child{margin-bottom:0}
@media(max-width:749px){
  .ss-acc-{{ sid }}{padding:{{ block.settings.mobile_pad_y }}px 14px}
  .ss-acc-{{ sid }} summary{padding:0 15px;font-size:14px}
  .ss-acc-{{ sid }} .ss-acc__body{padding:0 15px 16px}
}
</style>

{% schema %}
{
  "name": "SS Product Accordion",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product details" },
    { "type": "checkbox", "id": "first_open", "label": "Keep first item open", "default": true },

    { "type": "text", "id": "title_1", "label": "Title 1", "default": "Description" },
    { "type": "richtext", "id": "body_1", "label": "Content 1", "default": "<p>Designed with care to deliver comfort, quality and everyday performance.</p>" },

    { "type": "text", "id": "title_2", "label": "Title 2", "default": "Materials & Care" },
    { "type": "richtext", "id": "body_2", "label": "Content 2", "default": "<p>Use as recommended and keep away from excessive heat, moisture or rough handling.</p>" },

    { "type": "text", "id": "title_3", "label": "Title 3", "default": "Shipping" },
    { "type": "richtext", "id": "body_3", "label": "Content 3", "default": "<p>Orders are packed securely and shipped through reliable delivery partners.</p>" },

    { "type": "text", "id": "title_4", "label": "Title 4", "default": "Returns" },
    { "type": "richtext", "id": "body_4", "label": "Content 4", "default": "<p>Return eligibility depends on store policy and product condition.</p>" },

    { "type": "text", "id": "title_5", "label": "Title 5" },
    { "type": "richtext", "id": "body_5", "label": "Content 5" },

    { "type": "text", "id": "title_6", "label": "Title 6" },
    { "type": "richtext", "id": "body_6", "label": "Content 6" },

    { "type": "color", "id": "bg", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "card_bg", "label": "Item background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#161616" },
    { "type": "color", "id": "border", "label": "Border", "default": "#e8e2d8" },

    { "type": "range", "id": "width", "label": "Content width", "min": 520, "max": 1100, "step": 20, "default": 760 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 22, "max": 42, "step": 1, "default": 30 },
    { "type": "range", "id": "pad_y", "label": "Desktop vertical padding", "min": 20, "max": 90, "step": 2, "default": 42 },
    { "type": "range", "id": "mobile_pad_y", "label": "Mobile vertical padding", "min": 16, "max": 70, "step": 2, "default": 30 },
    { "type": "range", "id": "radius", "label": "Item radius", "min": 4, "max": 24, "step": 1, "default": 14 }
  ]
}
{% endschema %}