{% assign uid = block.id | replace: '-', '_' %}

<section class="ss-tabs ss-tabs-{{ uid }}">
  <div class="ss-tabs__inner">
    <div class="ss-tabs__header">
      <h2>{{ block.settings.heading }}</h2>
      <p>{{ block.settings.subheading }}</p>
    </div>

    <div class="ss-tabs__grid">
      <details open>
        <summary>{{ block.settings.tab_1_title }}</summary>
        <p>{{ block.settings.tab_1_text }}</p>
      </details>

      <details>
        <summary>{{ block.settings.tab_2_title }}</summary>
        <p>{{ block.settings.tab_2_text }}</p>
      </details>

      <details>
        <summary>{{ block.settings.tab_3_title }}</summary>
        <p>{{ block.settings.tab_3_text }}</p>
      </details>
    </div>
  </div>
</section>

<style>
  .ss-tabs-{{ uid }} {
    background: {{ block.settings.background }};
    padding: {{ block.settings.padding }}px 16px;
  }

  .ss-tabs-{{ uid }} .ss-tabs__inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .ss-tabs-{{ uid }} .ss-tabs__header {
    text-align: center;
    margin-bottom: 28px;
  }

  .ss-tabs-{{ uid }} h2 {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: clamp(28px, 4vw, 44px);
    letter-spacing: -0.04em;
  }

  .ss-tabs-{{ uid }} .ss-tabs__header p {
    color: {{ block.settings.text_color }};
    margin: 12px 0 0;
  }

  .ss-tabs-{{ uid }} details {
    background: {{ block.settings.card_bg }};
    border-radius: {{ block.settings.radius }}px;
    padding: 0 18px;
    margin-bottom: 12px;
    border: 1px solid rgba(0,0,0,0.08);
  }

  .ss-tabs-{{ uid }} summary {
    cursor: pointer;
    padding: 18px 0;
    font-weight: 900;
    color: {{ block.settings.heading_color }};
    list-style: none;
  }

  .ss-tabs-{{ uid }} summary::-webkit-details-marker {
    display: none;
  }

  .ss-tabs-{{ uid }} details p {
    color: {{ block.settings.text_color }};
    line-height: 1.7;
    margin: 0;
    padding-bottom: 18px;
  }
</style>

{% schema %}
{
  "name": "Shipping Returns Tabs",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping, returns & support" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Answer key buying questions clearly." },
    { "type": "text", "id": "tab_1_title", "label": "Tab 1 title", "default": "Shipping" },
    { "type": "textarea", "id": "tab_1_text", "label": "Tab 1 text", "default": "Orders are shipped quickly with tracking details shared after dispatch." },
    { "type": "text", "id": "tab_2_title", "label": "Tab 2 title", "default": "Returns" },
    { "type": "textarea", "id": "tab_2_text", "label": "Tab 2 text", "default": "We offer hassle-free returns as per the store return policy." },
    { "type": "text", "id": "tab_3_title", "label": "Tab 3 title", "default": "Support" },
    { "type": "textarea", "id": "tab_3_text", "label": "Tab 3 text", "default": "Our support team is available to help with order and product questions." },
    { "type": "color", "id": "background", "label": "Background", "default": "#F8FAFC" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#101828" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#667085" },
    { "type": "range", "id": "radius", "label": "Card radius", "min": 8, "max": 28, "step": 1, "default": 18 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 24, "max": 120, "step": 4, "default": 60 }
  ]
}
{% endschema %}