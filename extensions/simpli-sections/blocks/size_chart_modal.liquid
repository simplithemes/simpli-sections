{% liquid
  assign sid = block.id | replace: '_', ''
%}

<div class="ss-sc ss-sc-{{ sid }}" {{ block.shopify_attributes }}>
  <button type="button" class="ss-sc__trigger">
    {{ block.settings.button_text }}
  </button>

  <div class="ss-sc__modal" aria-hidden="true">
    <button type="button" class="ss-sc__overlay" aria-label="Close size chart"></button>

    <div class="ss-sc__box" role="dialog" aria-modal="true">
      <button type="button" class="ss-sc__close" aria-label="Close">×</button>

      {% if block.settings.heading != blank %}
        <h3>{{ block.settings.heading }}</h3>
      {% endif %}

      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 900 }}"
          alt="{{ block.settings.heading | escape }}"
          loading="lazy"
        >
      {% endif %}

      {% if block.settings.content != blank %}
        <div class="ss-sc__content">
          {{ block.settings.content }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
(() => {
  const root = document.querySelector('.ss-sc-{{ sid }}');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';

  const modal = root.querySelector('.ss-sc__modal');
  const open = root.querySelector('.ss-sc__trigger');
  const close = root.querySelector('.ss-sc__close');
  const overlay = root.querySelector('.ss-sc__overlay');

  const show = () => {
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
  };

  const hide = () => {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
  };

  open.addEventListener('click', show);
  close.addEventListener('click', hide);
  overlay.addEventListener('click', hide);

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) hide();
  });
})();
</script>

<style>
.ss-sc-{{ sid }}{
  display:inline-block;
}
.ss-sc-{{ sid }} .ss-sc__trigger{
  background:{{ block.settings.button_bg }};
  border:1px solid {{ block.settings.border }};
  color:{{ block.settings.link_color }};
  border-radius:{{ block.settings.button_radius }}px;
  padding:{{ block.settings.button_pad_y }}px {{ block.settings.button_pad_x }}px;
  font-weight:800;
  font-size:{{ block.settings.button_font_size }}px;
  cursor:pointer;
}
.ss-sc-{{ sid }} .ss-sc__modal{
  position:fixed;
  inset:0;
  display:none;
  z-index:9999;
}
.ss-sc-{{ sid }} .ss-sc__modal.is-open{
  display:block;
}
.ss-sc-{{ sid }} .ss-sc__overlay{
  position:absolute;
  inset:0;
  border:0;
  background:rgba(0,0,0,.6);
  cursor:pointer;
}
.ss-sc-{{ sid }} .ss-sc__box{
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  background:{{ block.settings.modal_bg }};
  color:{{ block.settings.text_color }};
  width:min(92vw, {{ block.settings.modal_width }}px);
  max-height:86vh;
  overflow:auto;
  border-radius:{{ block.settings.radius }}px;
  padding:22px;
  box-shadow:0 24px 70px rgba(0,0,0,.24);
}
.ss-sc-{{ sid }} h3{
  margin:0 34px 14px 0;
  font-size:{{ block.settings.heading_size }}px;
  line-height:1.2;
  color:inherit;
}
.ss-sc-{{ sid }} .ss-sc__close{
  position:absolute;
  top:12px;
  right:12px;
  width:34px;
  height:34px;
  border:0;
  border-radius:50%;
  background:#f3f4f6;
  color:#111;
  font-size:24px;
  line-height:1;
  cursor:pointer;
}
.ss-sc-{{ sid }} img{
  width:100%;
  display:block;
  border-radius:{{ block.settings.image_radius }}px;
  margin-top:10px;
}
.ss-sc-{{ sid }} .ss-sc__content{
  margin-top:14px;
  font-size:14px;
  line-height:1.65;
  color:inherit;
  opacity:.82;
}
.ss-sc-{{ sid }} .ss-sc__content p{
  margin:0 0 10px;
}
.ss-sc-{{ sid }} .ss-sc__content p:last-child{
  margin-bottom:0;
}
@media(max-width:749px){
  .ss-sc-{{ sid }} .ss-sc__box{
    padding:18px;
    width:92vw;
  }
  .ss-sc-{{ sid }} h3{
    font-size:22px;
  }
}
</style>

{% schema %}
{
  "name": "SS Size Chart Modal",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Size chart"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Size Guide"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Size chart image"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Add your size guide details here.</p>"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Button text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border",
      "label": "Button border",
      "default": "#e5e7eb"
    },
    {
      "type": "color",
      "id": "modal_bg",
      "label": "Modal background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Modal text",
      "default": "#151515"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button font size",
      "min": 12,
      "max": 18,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "button_pad_y",
      "label": "Button vertical padding",
      "min": 6,
      "max": 18,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "button_pad_x",
      "label": "Button horizontal padding",
      "min": 10,
      "max": 28,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "modal_width",
      "label": "Modal width",
      "min": 420,
      "max": 900,
      "step": 20,
      "default": 700
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 36,
      "step": 1,
      "default": 26
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Modal radius",
      "min": 8,
      "max": 30,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 12
    }
  ]
}
{% endschema %}