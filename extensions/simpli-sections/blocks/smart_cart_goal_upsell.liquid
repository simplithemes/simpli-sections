{% liquid
  assign sid = block.id | replace: '_', ''
  assign upsell = block.settings.upsell_product
%}

<div class="ss-cg ss-cg-{{ sid }}" {{ block.shopify_attributes }}>
  <div class="ss-cg__box">
    <div class="ss-cg__top">
      {% if block.settings.heading != blank %}
        <strong>{{ block.settings.heading }}</strong>
      {% endif %}

      <span class="ss-cg__msg"></span>
    </div>

    <div class="ss-cg__bar">
      <span></span>
    </div>

    {% if upsell %}
      <div class="ss-cg__upsell">
        {% if upsell.featured_image %}
          <img
            src="{{ upsell.featured_image | image_url: width: 160 }}"
            alt="{{ upsell.title | escape }}"
          >
        {% endif %}

        <div>
          <strong>{{ upsell.title }}</strong>
          <small>{{ upsell.selected_or_first_available_variant.price | money }}</small>
        </div>

        <button
          type="button"
          data-id="{{ upsell.selected_or_first_available_variant.id }}"
        >
          {{ block.settings.button_text }}
        </button>
      </div>
    {% endif %}
  </div>
</div>

<script>
(() => {
  const root = document.querySelector('.ss-cg-{{ sid }}');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';

  const goal = {{ block.settings.goal | times: 100 }};
  const msg = root.querySelector('.ss-cg__msg');
  const fill = root.querySelector('.ss-cg__bar span');
  const btn = root.querySelector('button[data-id]');

  const money = cents => {
    try {
      return new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency: '{{ cart.currency.iso_code }}'
      }).format(cents / 100);
    } catch(e) {
      return (cents / 100).toFixed(2);
    }
  };

  async function update(){
    try {
      const cart = await fetch('/cart.js').then(r => r.json());
      const left = Math.max(goal - cart.total_price, 0);
      const progress = Math.min((cart.total_price / goal) * 100, 100);

      fill.style.width = progress + '%';

      msg.textContent = left > 0
        ? money(left) + ' away from {{ block.settings.reward_text }}'
        : '{{ block.settings.success_text }}';
    } catch(e) {}
  }

  if (btn) {
    btn.addEventListener('click', async () => {
      btn.disabled = true;

      try {
        await fetch('/cart/add.js', {
          method:'POST',
          headers:{
            'Content-Type':'application/json',
            'Accept':'application/json'
          },
          body:JSON.stringify({
            id:Number(btn.dataset.id),
            quantity:1
          })
        });

        document.dispatchEvent(new CustomEvent('cart:refresh'));
        document.dispatchEvent(new CustomEvent('cart:open'));

        await update();

        btn.textContent='{{ block.settings.added_text }}';

        setTimeout(() => {
          btn.textContent='{{ block.settings.button_text }}';
        }, 1400);
      } catch(e) {
        btn.textContent='Try again';
      }

      btn.disabled = false;
    });
  }

  document.addEventListener('cart:refresh', update);
  update();
})();
</script>

<style>
.ss-cg-{{ sid }}{
  padding:{{ block.settings.pad_y }}px 16px;
  background:{{ block.settings.bg }};
  color:{{ block.settings.text_color }};
}
.ss-cg-{{ sid }} .ss-cg__box{
  max-width:{{ block.settings.width }}px;
  margin:auto;
  padding:18px;
  border-radius:{{ block.settings.radius }}px;
  background:{{ block.settings.card_bg }};
  border:1px solid {{ block.settings.border }};
}
.ss-cg-{{ sid }} .ss-cg__top{
  display:flex;
  justify-content:space-between;
  gap:14px;
  margin-bottom:12px;
  font-size:14px;
}
.ss-cg-{{ sid }} .ss-cg__top strong{
  font-weight:800;
}
.ss-cg-{{ sid }} .ss-cg__msg{
  opacity:.75;
  text-align:right;
}
.ss-cg-{{ sid }} .ss-cg__bar{
  height:9px;
  background:{{ block.settings.track }};
  border-radius:999px;
  overflow:hidden;
}
.ss-cg-{{ sid }} .ss-cg__bar span{
  display:block;
  height:100%;
  width:0;
  background:{{ block.settings.accent }};
  transition:width .35s ease;
}
.ss-cg-{{ sid }} .ss-cg__upsell{
  margin-top:16px;
  display:grid;
  grid-template-columns:58px 1fr auto;
  align-items:center;
  gap:12px;
}
.ss-cg-{{ sid }} img{
  width:58px;
  height:58px;
  border-radius:12px;
  object-fit:cover;
  background:#f4f4f4;
}
.ss-cg-{{ sid }} .ss-cg__upsell strong{
  display:block;
  font-size:14px;
  line-height:1.3;
}
.ss-cg-{{ sid }} small{
  display:block;
  opacity:.65;
  margin-top:4px;
  font-size:13px;
}
.ss-cg-{{ sid }} button{
  border:0;
  border-radius:{{ block.settings.button_radius }}px;
  padding:11px 14px;
  background:{{ block.settings.button_bg }};
  color:{{ block.settings.button_text_color }};
  font-weight:800;
  cursor:pointer;
}
.ss-cg-{{ sid }} button:disabled{
  opacity:.65;
}
@media(max-width:599px){
  .ss-cg-{{ sid }}{
    padding:{{ block.settings.mobile_pad_y }}px 14px;
  }
  .ss-cg-{{ sid }} .ss-cg__top{
    display:block;
  }
  .ss-cg-{{ sid }} .ss-cg__msg{
    display:block;
    text-align:left;
    margin-top:5px;
  }
  .ss-cg-{{ sid }} .ss-cg__upsell{
    grid-template-columns:52px 1fr;
  }
  .ss-cg-{{ sid }} button{
    grid-column:1/-1;
    width:100%;
  }
}
</style>

{% schema %}
{
  "name": "SS Cart Goal Upsell",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Cart reward"
    },
    {
      "type": "range",
      "id": "goal",
      "label": "Goal amount",
      "min": 500,
      "max": 9900,
      "step": 100,
      "default": 2000
    },
    {
      "type": "text",
      "id": "reward_text",
      "label": "Reward text",
      "default": "free shipping"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success text",
      "default": "You unlocked the reward!"
    },
    {
      "type": "product",
      "id": "upsell_product",
      "label": "Upsell product"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Add"
    },
    {
      "type": "text",
      "id": "added_text",
      "label": "Added text",
      "default": "Added"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#fbfaf7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#151515"
    },
    {
      "type": "color",
      "id": "border",
      "label": "Border",
      "default": "#eee7da"
    },
    {
      "type": "color",
      "id": "track",
      "label": "Progress track",
      "default": "#ebe3d6"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Progress color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "pad_y",
      "label": "Desktop vertical padding",
      "min": 12,
      "max": 70,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_pad_y",
      "label": "Mobile vertical padding",
      "min": 12,
      "max": 70,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "width",
      "label": "Width",
      "min": 420,
      "max": 1000,
      "step": 20,
      "default": 680
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Card radius",
      "min": 8,
      "max": 30,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    }
  ]
}
{% endschema %}