{% assign uid = block.id | replace: '-', '_' %}
{% assign product = block.settings.product %}

<section class="ss-sticky-atc ss-sticky-atc-{{ uid }}">
  <div class="ss-sticky-atc__bar">
    <div class="ss-sticky-atc__product">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" loading="lazy">
      {% endif %}

      <div>
        <strong>
          {% if product != blank %}
            {{ product.title }}
          {% else %}
            {{ block.settings.fallback_title }}
          {% endif %}
        </strong>

        {% if product != blank %}
          <span>{{ product.price | money }}</span>
        {% else %}
          <span>{{ block.settings.fallback_price }}</span>
        {% endif %}
      </div>
    </div>

    {% if product != blank %}
      <button type="button" data-variant="{{ product.selected_or_first_available_variant.id }}">
        {{ block.settings.button_text }}
      </button>
    {% else %}
      <button type="button" disabled>{{ block.settings.button_text }}</button>
    {% endif %}
  </div>
</section>

<style>
  .ss-sticky-atc-{{ uid }} .ss-sticky-atc__bar {
    position: fixed;
    left: 18px;
    right: 18px;
    bottom: 18px;
    z-index: 999;
    max-width: 980px;
    margin: 0 auto;
    background: {{ block.settings.background }};
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: {{ block.settings.radius }}px;
    padding: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    box-shadow: 0 20px 70px rgba(15,23,42,0.18);
  }

  .ss-sticky-atc-{{ uid }} .ss-sticky-atc__product {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .ss-sticky-atc-{{ uid }} img {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    object-fit: cover;
  }

  .ss-sticky-atc-{{ uid }} strong {
    display: block;
    color: {{ block.settings.heading_color }};
    font-size: 15px;
    line-height: 1.2;
  }

  .ss-sticky-atc-{{ uid }} span {
    display: block;
    color: {{ block.settings.text_color }};
    font-size: 13px;
    margin-top: 4px;
  }

  .ss-sticky-atc-{{ uid }} button {
    border: 0;
    border-radius: 999px;
    padding: 14px 20px;
    background: {{ block.settings.button_bg }};
    color: {{ block.settings.button_color }};
    font-weight: 900;
    cursor: pointer;
    white-space: nowrap;
  }

  @media(max-width: 749px) {
    .ss-sticky-atc-{{ uid }} .ss-sticky-atc__bar {
      left: 10px;
      right: 10px;
      bottom: 10px;
    }

    .ss-sticky-atc-{{ uid }} button {
      padding: 13px 16px;
      font-size: 13px;
    }
  }
</style>

<script>
  (function () {
    const section = document.querySelector('.ss-sticky-atc-{{ uid }}');
    if (!section) return;

    const button = section.querySelector('button[data-variant]');
    if (!button) return;

    button.addEventListener('click', function () {
      button.textContent = 'Adding...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          id: Number(button.dataset.variant),
          quantity: 1
        })
      }).then(function () {
        window.location.href = '/cart';
      }).catch(function () {
        button.textContent = '{{ block.settings.button_text }}';
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Sticky Add to Cart",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "fallback_title", "label": "Fallback title", "default": "Selected product" },
    { "type": "text", "id": "fallback_price", "label": "Fallback price", "default": "Ready to buy" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Add to cart" },
    { "type": "color", "id": "background", "label": "Bar background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#101828" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#667085" },
    { "type": "color_background", "id": "button_bg", "label": "Button background", "default": "linear-gradient(135deg, #101828, #3A084E)" },
    { "type": "color", "id": "button_color", "label": "Button text color", "default": "#FFFFFF" },
    { "type": "range", "id": "radius", "label": "Bar radius", "min": 12, "max": 36, "step": 1, "default": 24 }
  ]
}
{% endschema %}