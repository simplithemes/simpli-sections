{% assign uid = block.id | replace: '-', '_' %}

<section class="ss-stock ss-stock-{{ uid }}">
  <div class="ss-stock__box">
    <div class="ss-stock__top">
      <span>{{ block.settings.icon }}</span>
      <div>
        <strong>{{ block.settings.heading }}</strong>
        <p>{{ block.settings.text }}</p>
      </div>
    </div>

    <div class="ss-stock__bar">
      <div style="width: {{ block.settings.stock_percent }}%;"></div>
    </div>

    <small>{{ block.settings.bottom_text }}</small>
  </div>
</section>

<style>
  .ss-stock-{{ uid }} {
    background: {{ block.settings.background }};
    padding: {{ block.settings.padding }}px 16px;
  }

  .ss-stock-{{ uid }} .ss-stock__box {
    max-width: 720px;
    margin: 0 auto;
    background: {{ block.settings.card_bg }};
    border-radius: {{ block.settings.radius }}px;
    padding: 22px;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 18px 50px rgba(15,23,42,0.08);
  }

  .ss-stock-{{ uid }} .ss-stock__top {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-bottom: 16px;
  }

  .ss-stock-{{ uid }} span {
    width: 48px;
    height: 48px;
    border-radius: 16px;
    background: {{ block.settings.icon_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
  }

  .ss-stock-{{ uid }} strong {
    display: block;
    color: {{ block.settings.heading_color }};
    font-size: 19px;
    letter-spacing: -0.02em;
  }

  .ss-stock-{{ uid }} p {
    color: {{ block.settings.text_color }};
    margin: 4px 0 0;
  }

  .ss-stock-{{ uid }} .ss-stock__bar {
    height: 12px;
    background: {{ block.settings.track_bg }};
    border-radius: 999px;
    overflow: hidden;
  }

  .ss-stock-{{ uid }} .ss-stock__bar div {
    height: 100%;
    background: {{ block.settings.fill_bg }};
    border-radius: 999px;
  }

  .ss-stock-{{ uid }} small {
    display: block;
    margin-top: 12px;
    color: {{ block.settings.text_color }};
    font-weight: 800;
  }
</style>

{% schema %}
{
  "name": "Stock Counter",
  "target": "section",
  "settings": [
    { "type": "text", "id": "icon", "label": "Icon", "default": "🔥" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Selling fast" },
    { "type": "text", "id": "text", "label": "Text", "default": "Only a few units left in stock." },
    { "type": "text", "id": "bottom_text", "label": "Bottom text", "default": "Order now before this product sells out." },
    { "type": "range", "id": "stock_percent", "label": "Stock bar percentage", "min": 5, "max": 100, "step": 5, "default": 35 },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#F8FAFC" },
    { "type": "color", "id": "icon_bg", "label": "Icon background", "default": "#FEF2F2" },
    { "type": "color", "id": "track_bg", "label": "Track background", "default": "#E5E7EB" },
    { "type": "color_background", "id": "fill_bg", "label": "Fill background", "default": "linear-gradient(135deg, #DC2626, #F97316)" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#101828" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#667085" },
    { "type": "range", "id": "radius", "label": "Radius", "min": 10, "max": 36, "step": 1, "default": 24 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 16, "max": 80, "step": 4, "default": 32 }
  ]
}
{% endschema %}