{% liquid
  assign sid = block.id | replace: '_', ''
%}

<div class="ss-tc ss-tc-{{ sid }}" {{ block.shopify_attributes }}>
  <div class="ss-tc__wrap">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ss-tc__head">
        {% if block.settings.heading != blank %}<h2>{{ block.settings.heading }}</h2>{% endif %}
        {% if block.settings.subheading != blank %}<p>{{ block.settings.subheading }}</p>{% endif %}
      </div>
    {% endif %}

    <div class="ss-tc__viewport">
      <div class="ss-tc__track">
        {% for i in (1..6) %}
          {% assign name_key = 'name_' | append: i %}
          {% assign review_key = 'review_' | append: i %}
          {% assign rating_key = 'rating_' | append: i %}
          {% assign tag_key = 'tag_' | append: i %}
          {% assign name = block.settings[name_key] %}
          {% assign review = block.settings[review_key] %}
          {% assign rating = block.settings[rating_key] %}
          {% assign tag = block.settings[tag_key] %}

          {% if name != blank and review != blank %}
            <article class="ss-tc__card">
              <div class="ss-tc__stars" aria-label="{{ rating }} star rating">
                {% for s in (1..5) %}
                  <span>{% if s <= rating %}★{% else %}☆{% endif %}</span>
                {% endfor %}
              </div>
              <p class="ss-tc__review">“{{ review }}”</p>
              <div class="ss-tc__person">
                <strong>{{ name }}</strong>
                {% if tag != blank %}<small>{{ tag }}</small>{% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
(() => {
  const root = document.querySelector('.ss-tc-{{ sid }}');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';
  const track = root.querySelector('.ss-tc__track');
  if (!track || track.children.length < 2) return;
  let i = 0;
  setInterval(() => {
    i = (i + 1) % track.children.length;
    track.scrollTo({ left: track.children[i].offsetLeft, behavior: 'smooth' });
  }, {{ block.settings.autoplay_speed | times: 1000 }});
})();
</script>

<style>
.ss-tc-{{ sid }}{
  background:{{ block.settings.bg }};
  color:{{ block.settings.text_color }};
  padding:{{ block.settings.pad_y }}px 16px;
}
.ss-tc-{{ sid }} .ss-tc__wrap{
  max-width:{{ block.settings.max_width }}px;
  margin:auto;
}
.ss-tc-{{ sid }} .ss-tc__head{
  text-align:center;
  max-width:720px;
  margin:0 auto 28px;
}
.ss-tc-{{ sid }} h2{
  margin:0;
  font-size:clamp(24px,3.4vw,{{ block.settings.heading_size }}px);
  line-height:1.12;
  color:inherit;
}
.ss-tc-{{ sid }} .ss-tc__head p{
  margin:10px 0 0;
  font-size:15px;
  opacity:.7;
}
.ss-tc-{{ sid }} .ss-tc__track{
  display:grid;
  grid-auto-flow:column;
  grid-auto-columns:calc((100% - 32px)/3);
  gap:16px;
  overflow-x:auto;
  scroll-snap-type:x mandatory;
  scrollbar-width:none;
  -webkit-overflow-scrolling:touch;
}
.ss-tc-{{ sid }} .ss-tc__track::-webkit-scrollbar{display:none}
.ss-tc-{{ sid }} .ss-tc__card{
  scroll-snap-align:start;
  background:{{ block.settings.card_bg }};
  border:1px solid {{ block.settings.border }};
  border-radius:{{ block.settings.radius }}px;
  padding:24px;
  min-height:220px;
  display:flex;
  flex-direction:column;
  box-shadow:0 14px 36px rgba(0,0,0,.05);
}
.ss-tc-{{ sid }} .ss-tc__stars{
  color:{{ block.settings.star_color }};
  letter-spacing:1px;
  font-size:15px;
  margin-bottom:14px;
}
.ss-tc-{{ sid }} .ss-tc__review{
  margin:0;
  font-size:15px;
  line-height:1.65;
  opacity:.82;
}
.ss-tc-{{ sid }} .ss-tc__person{
  margin-top:auto;
  padding-top:20px;
}
.ss-tc-{{ sid }} .ss-tc__person strong{
  display:block;
  font-size:14px;
}
.ss-tc-{{ sid }} .ss-tc__person small{
  display:block;
  margin-top:3px;
  opacity:.58;
  font-size:12px;
}
@media(max-width:899px){
  .ss-tc-{{ sid }} .ss-tc__track{grid-auto-columns:calc((100% - 16px)/2)}
}
@media(max-width:599px){
  .ss-tc-{{ sid }}{padding:{{ block.settings.mobile_pad_y }}px 14px}
  .ss-tc-{{ sid }} .ss-tc__track{grid-auto-columns:86%}
  .ss-tc-{{ sid }} .ss-tc__card{padding:20px;min-height:210px}
}
</style>

{% schema %}
{
  "name": "SS Testimonials Carousel",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by customers" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real experiences from people who shop with us." },

    { "type": "text", "id": "name_1", "label": "Name 1", "default": "Aarav Mehta" },
    { "type": "range", "id": "rating_1", "label": "Rating 1", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "textarea", "id": "review_1", "label": "Review 1", "default": "The quality feels excellent and the delivery experience was smooth from start to finish." },
    { "type": "text", "id": "tag_1", "label": "Tag 1", "default": "Verified buyer" },

    { "type": "text", "id": "name_2", "label": "Name 2", "default": "Priya Sharma" },
    { "type": "range", "id": "rating_2", "label": "Rating 2", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "textarea", "id": "review_2", "label": "Review 2", "default": "Beautiful product, premium packaging and exactly the kind of experience I expected." },
    { "type": "text", "id": "tag_2", "label": "Tag 2", "default": "Repeat customer" },

    { "type": "text", "id": "name_3", "label": "Name 3", "default": "Rohan Kapoor" },
    { "type": "range", "id": "rating_3", "label": "Rating 3", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "textarea", "id": "review_3", "label": "Review 3", "default": "The buying journey was easy and the product matched the description perfectly." },
    { "type": "text", "id": "tag_3", "label": "Tag 3", "default": "Verified buyer" },

    { "type": "text", "id": "name_4", "label": "Name 4" },
    { "type": "range", "id": "rating_4", "label": "Rating 4", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "textarea", "id": "review_4", "label": "Review 4" },
    { "type": "text", "id": "tag_4", "label": "Tag 4" },

    { "type": "text", "id": "name_5", "label": "Name 5" },
    { "type": "range", "id": "rating_5", "label": "Rating 5", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "textarea", "id": "review_5", "label": "Review 5" },
    { "type": "text", "id": "tag_5", "label": "Tag 5" },

    { "type": "text", "id": "name_6", "label": "Name 6" },
    { "type": "range", "id": "rating_6", "label": "Rating 6", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "textarea", "id": "review_6", "label": "Review 6" },
    { "type": "text", "id": "tag_6", "label": "Tag 6" },

    { "type": "color", "id": "bg", "label": "Section background", "default": "#fbfaf7" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#151515" },
    { "type": "color", "id": "border", "label": "Border", "default": "#eee7da" },
    { "type": "color", "id": "star_color", "label": "Star color", "default": "#c99a3f" },

    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 48, "step": 1, "default": 36 },
    { "type": "range", "id": "pad_y", "label": "Desktop vertical padding", "min": 26, "max": 100, "step": 2, "default": 56 },
    { "type": "range", "id": "mobile_pad_y", "label": "Mobile vertical padding", "min": 20, "max": 80, "step": 2, "default": 38 },
    { "type": "range", "id": "radius", "label": "Card radius", "min": 8, "max": 30, "step": 1, "default": 20 },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 900, "max": 1600, "step": 50, "default": 1200 },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed", "min": 3, "max": 10, "step": 1, "default": 5 }
  ]
}
{% endschema %}