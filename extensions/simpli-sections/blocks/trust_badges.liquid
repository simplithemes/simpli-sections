{% liquid
  assign sid = block.id | replace: '_', ''
%}

<div class="ss-tb ss-tb-{{ sid }}" {{ block.shopify_attributes }}>
  <div class="ss-tb__wrap">
    {% if block.settings.heading != blank %}
      <h2>{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ss-tb__grid">
      {% for i in (1..4) %}
        {% assign icon_key = 'icon_' | append: i %}
        {% assign title_key = 'title_' | append: i %}
        {% assign text_key = 'text_' | append: i %}
        {% assign icon = block.settings[icon_key] %}
        {% assign title = block.settings[title_key] %}
        {% assign text = block.settings[text_key] %}

        {% if title != blank or text != blank %}
          <div class="ss-tb__card">
            {% if icon != blank %}
              <div class="ss-tb__icon">{{ icon }}</div>
            {% endif %}
            <div>
              {% if title != blank %}<strong>{{ title }}</strong>{% endif %}
              {% if text != blank %}<p>{{ text }}</p>{% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
.ss-tb-{{ sid }}{
  background:{{ block.settings.bg }};
  color:{{ block.settings.text_color }};
  padding:{{ block.settings.pad_y }}px 16px;
}
.ss-tb-{{ sid }} .ss-tb__wrap{
  max-width:{{ block.settings.max_width }}px;
  margin:auto;
}
.ss-tb-{{ sid }} h2{
  margin:0 0 22px;
  text-align:center;
  font-size:clamp(22px,3vw,{{ block.settings.heading_size }}px);
  line-height:1.15;
  color:inherit;
}
.ss-tb-{{ sid }} .ss-tb__grid{
  display:grid;
  grid-template-columns:repeat({{ block.settings.columns }},1fr);
  gap:{{ block.settings.gap }}px;
}
.ss-tb-{{ sid }} .ss-tb__card{
  display:flex;
  align-items:flex-start;
  gap:14px;
  padding:20px;
  border-radius:{{ block.settings.radius }}px;
  background:{{ block.settings.card_bg }};
  border:1px solid {{ block.settings.border }};
  box-shadow:0 10px 30px rgba(0,0,0,.04);
}
.ss-tb-{{ sid }} .ss-tb__icon{
  width:42px;
  height:42px;
  flex:0 0 42px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:{{ block.settings.icon_bg }};
  font-size:22px;
}
.ss-tb-{{ sid }} strong{
  display:block;
  font-size:15px;
  line-height:1.25;
  margin-bottom:5px;
}
.ss-tb-{{ sid }} p{
  margin:0;
  font-size:13px;
  line-height:1.45;
  opacity:.72;
}
@media(max-width:899px){
  .ss-tb-{{ sid }} .ss-tb__grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:599px){
  .ss-tb-{{ sid }}{padding:{{ block.settings.mobile_pad_y }}px 14px}
  .ss-tb-{{ sid }} .ss-tb__grid{grid-template-columns:1fr;gap:12px}
  .ss-tb-{{ sid }} .ss-tb__card{padding:16px}
}
</style>

{% schema %}
{
  "name": "SS Trust Badges",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why customers trust us" },

    { "type": "text", "id": "icon_1", "label": "Icon 1", "default": "🚚" },
    { "type": "text", "id": "title_1", "label": "Title 1", "default": "Fast Delivery" },
    { "type": "text", "id": "text_1", "label": "Text 1", "default": "Quick and reliable shipping across serviceable locations." },

    { "type": "text", "id": "icon_2", "label": "Icon 2", "default": "🔒" },
    { "type": "text", "id": "title_2", "label": "Title 2", "default": "Secure Payments" },
    { "type": "text", "id": "text_2", "label": "Text 2", "default": "Protected checkout with trusted payment options." },

    { "type": "text", "id": "icon_3", "label": "Icon 3", "default": "↩️" },
    { "type": "text", "id": "title_3", "label": "Title 3", "default": "Easy Returns" },
    { "type": "text", "id": "text_3", "label": "Text 3", "default": "Simple return support for a smooth shopping experience." },

    { "type": "text", "id": "icon_4", "label": "Icon 4", "default": "⭐" },
    { "type": "text", "id": "title_4", "label": "Title 4", "default": "Premium Quality" },
    { "type": "text", "id": "text_4", "label": "Text 4", "default": "Thoughtfully selected products made for everyday use." },

    { "type": "color", "id": "bg", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#fbfaf7" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#151515" },
    { "type": "color", "id": "icon_bg", "label": "Icon background", "default": "#f1eadf" },
    { "type": "color", "id": "border", "label": "Border", "default": "#eee7da" },

    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 46, "step": 1, "default": 32 },
    { "type": "range", "id": "pad_y", "label": "Desktop vertical padding", "min": 24, "max": 90, "step": 2, "default": 48 },
    { "type": "range", "id": "mobile_pad_y", "label": "Mobile vertical padding", "min": 18, "max": 70, "step": 2, "default": 34 },
    { "type": "range", "id": "gap", "label": "Card gap", "min": 8, "max": 30, "step": 1, "default": 16 },
    { "type": "range", "id": "radius", "label": "Card radius", "min": 6, "max": 28, "step": 1, "default": 18 },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 900, "max": 1600, "step": 50, "default": 1200 }
  ]
}
{% endschema %}