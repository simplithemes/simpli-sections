{% liquid
  assign sid = block.id | replace: '_', ''
%}

<div class="ss-vc ss-vc-{{ sid }}" {{ block.shopify_attributes }}>
  <div class="ss-vc__wrap">

    {% if block.settings.heading != blank %}
      <h2>{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ss-vc__track">
      {% for i in (1..6) %}
        {% assign video_key = 'video_' | append: i %}
        {% assign poster_key = 'poster_' | append: i %}

        {% assign video = block.settings[video_key] %}
        {% assign poster = block.settings[poster_key] %}

        {% if video != blank %}
          <div class="ss-vc__item">
            <video
              src="{{ video }}"
              {% if poster %}poster="{{ poster | image_url: width: 600 }}"{% endif %}
              playsinline
              muted
              loop
              preload="metadata"
            ></video>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</div>

<script>
(() => {
  const root = document.querySelector('.ss-vc-{{ sid }}');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';

  const videos = root.querySelectorAll('video');

  const io = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.play().catch(() => {});
      } else {
        entry.target.pause();
      }
    });
  }, { threshold: 0.6 });

  videos.forEach(v => io.observe(v));
})();
</script>

<style>
.ss-vc-{{ sid }}{
  padding:{{ block.settings.pad_y }}px 16px;
  background:{{ block.settings.bg }};
}
.ss-vc-{{ sid }} .ss-vc__wrap{
  max-width:{{ block.settings.width }}px;
  margin:auto;
}
.ss-vc-{{ sid }} h2{
  margin:0 0 16px;
  font-size:clamp(22px,3vw,{{ block.settings.heading_size }}px);
  line-height:1.15;
}
.ss-vc-{{ sid }} .ss-vc__track{
  display:flex;
  gap:12px;
  overflow-x:auto;
  scroll-snap-type:x mandatory;
}
.ss-vc-{{ sid }} .ss-vc__track::-webkit-scrollbar{
  display:none;
}
.ss-vc-{{ sid }} .ss-vc__item{
  min-width:180px;
  border-radius:14px;
  overflow:hidden;
  background:#000;
  scroll-snap-align:start;
}
.ss-vc-{{ sid }} video{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}
@media(min-width:750px){
  .ss-vc-{{ sid }} .ss-vc__item{
    min-width:240px;
  }
}
</style>

{% schema %}
{
  "name": "SS Video Carousel",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch in action"
    },

    {
      "type": "url",
      "id": "video_1",
      "label": "Video 1 URL"
    },
    {
      "type": "image_picker",
      "id": "poster_1",
      "label": "Poster 1"
    },

    {
      "type": "url",
      "id": "video_2",
      "label": "Video 2 URL"
    },
    {
      "type": "image_picker",
      "id": "poster_2",
      "label": "Poster 2"
    },

    {
      "type": "url",
      "id": "video_3",
      "label": "Video 3 URL"
    },
    {
      "type": "image_picker",
      "id": "poster_3",
      "label": "Poster 3"
    },

    {
      "type": "url",
      "id": "video_4",
      "label": "Video 4 URL"
    },
    {
      "type": "url",
      "id": "video_5",
      "label": "Video 5 URL"
    },
    {
      "type": "url",
      "id": "video_6",
      "label": "Video 6 URL"
    },

    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 22,
      "max": 40,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
      "id": "pad_y",
      "label": "Vertical padding",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "width",
      "label": "Content width",
      "min": 900,
      "max": 1600,
      "step": 50,
      "default": 1200
    }
  ]
}
{% endschema %}