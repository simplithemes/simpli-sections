{% liquid
  assign sid = block.id | replace: '_', ''
%}

<section class="ss-wb ss-wb-{{ sid }}" {{ block.shopify_attributes }}>
  <div class="ss-wb__wrap">
    <div class="ss-wb__content">
      {% if block.settings.eyebrow != blank %}
        <p class="ss-wb__eyebrow">{{ block.settings.eyebrow }}</p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2>{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <p class="ss-wb__text">{{ block.settings.text }}</p>
      {% endif %}

      {% if block.settings.button_label != blank %}
        <a class="ss-wb__button" href="{{ block.settings.button_link }}">
          {{ block.settings.button_label }}
        </a>
      {% endif %}
    </div>

    <div class="ss-wb__visual" aria-hidden="true">
      <div class="ss-wb__panel ss-wb__panel--main"></div>
      <div class="ss-wb__mini-row">
        <div class="ss-wb__panel"></div>
        <div class="ss-wb__panel"></div>
        <div class="ss-wb__panel"></div>
      </div>
    </div>
  </div>
</section>

<style>
.ss-wb-{{ sid }}{
  background:{{ block.settings.bg }};
  color:{{ block.settings.text_color }};
  padding:{{ block.settings.pad_y }}px 16px;
}
.ss-wb-{{ sid }} .ss-wb__wrap{
  max-width:{{ block.settings.max_width }}px;
  margin:0 auto;
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(280px,.82fr);
  gap:32px;
  align-items:center;
}
.ss-wb-{{ sid }} .ss-wb__eyebrow{
  margin:0 0 10px;
  font-size:12px;
  letter-spacing:.08em;
  text-transform:uppercase;
  font-weight:800;
  color:{{ block.settings.accent }};
}
.ss-wb-{{ sid }} h2{
  margin:0;
  font-size:clamp(30px,5vw,{{ block.settings.heading_size }}px);
  line-height:1.02;
  letter-spacing:-.04em;
  color:inherit;
}
.ss-wb-{{ sid }} .ss-wb__text{
  max-width:620px;
  margin:16px 0 0;
  font-size:16px;
  line-height:1.7;
  color:inherit;
  opacity:.74;
}
.ss-wb-{{ sid }} .ss-wb__button{
  display:inline-flex;
  margin-top:22px;
  padding:13px 18px;
  border-radius:999px;
  background:{{ block.settings.button_bg }};
  color:{{ block.settings.button_text }};
  text-decoration:none;
  font-size:14px;
  font-weight:800;
}
.ss-wb-{{ sid }} .ss-wb__visual{
  border-radius:{{ block.settings.radius }}px;
  min-height:340px;
  padding:18px;
  background:linear-gradient(135deg, {{ block.settings.accent }} 0%, {{ block.settings.visual_bg }} 100%);
  display:grid;
  gap:14px;
  align-content:end;
  box-shadow:0 22px 60px rgba(15,23,42,.12);
}
.ss-wb-{{ sid }} .ss-wb__panel{
  border-radius:18px;
  background:rgba(255,255,255,.86);
  min-height:86px;
}
.ss-wb-{{ sid }} .ss-wb__panel--main{
  min-height:190px;
}
.ss-wb-{{ sid }} .ss-wb__mini-row{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}
@media(max-width:749px){
  .ss-wb-{{ sid }}{
    padding:{{ block.settings.mobile_pad_y }}px 14px;
  }
  .ss-wb-{{ sid }} .ss-wb__wrap{
    grid-template-columns:1fr;
    gap:22px;
  }
  .ss-wb-{{ sid }} .ss-wb__visual{
    min-height:260px;
  }
}
</style>

{% schema %}
{
  "name": "SS Website Builder",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "section_preset",
      "label": "Section preset",
      "default": "hero",
      "options": [
        { "value": "header", "label": "Header" },
        { "value": "hero", "label": "Homepage hero" },
        { "value": "category_grid", "label": "Category grid" },
        { "value": "brand_story", "label": "Brand story" },
        { "value": "footer", "label": "Footer" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Premium Shopify homepage" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build a premium storefront in minutes" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Use this flexible Simpli Sections block for homepage hero, story, category, header-style, and footer-style layouts." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111827" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#14532d" },
    { "type": "color", "id": "visual_bg", "label": "Visual background", "default": "#d1fae5" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#111827" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#ffffff" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 34, "max": 72, "step": 1, "default": 56 },
    { "type": "range", "id": "pad_y", "label": "Desktop vertical padding", "min": 30, "max": 110, "step": 2, "default": 64 },
    { "type": "range", "id": "mobile_pad_y", "label": "Mobile vertical padding", "min": 24, "max": 80, "step": 2, "default": 42 },
    { "type": "range", "id": "radius", "label": "Visual radius", "min": 10, "max": 34, "step": 1, "default": 24 },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 900, "max": 1600, "step": 50, "default": 1200 }
  ]
}
{% endschema %}
