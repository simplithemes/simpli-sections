{% assign uid = block.id | replace: '-', '_' %}

<section class="ss-wa ss-wa-{{ uid }}">
  <a
    href="https://wa.me/{{ block.settings.phone_number }}?text={{ block.settings.message | url_encode }}"
    class="ss-wa__button"
    target="_blank"
    rel="noopener"
  >
    <span>{{ block.settings.icon }}</span>
    <strong>{{ block.settings.button_text }}</strong>
  </a>
</section>

<style>
  .ss-wa-{{ uid }} .ss-wa__button {
    position: fixed;
    {% if block.settings.position == 'left' %}
      left: 18px;
      right: auto;
    {% else %}
      right: 18px;
      left: auto;
    {% endif %}
    bottom: {{ block.settings.bottom_spacing }}px;
    z-index: 999;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: {{ block.settings.background }};
    color: {{ block.settings.text_color }};
    border-radius: 999px;
    padding: 13px 18px;
    text-decoration: none;
    box-shadow: 0 18px 50px rgba(15,23,42,0.18);
    font-weight: 900;
  }

  .ss-wa-{{ uid }} span {
    font-size: 22px;
    line-height: 1;
  }

  .ss-wa-{{ uid }} strong {
    font-size: 14px;
  }

  @media(max-width: 749px) {
    .ss-wa-{{ uid }} strong {
      display: {% if block.settings.show_text_mobile %}block{% else %}none{% endif %};
    }

    .ss-wa-{{ uid }} .ss-wa__button {
      padding: 13px 15px;
      bottom: {{ block.settings.mobile_bottom_spacing }}px;
    }
  }
</style>

{% schema %}
{
  "name": "WhatsApp Floating Button",
  "target": "section",
  "settings": [
    { "type": "text", "id": "phone_number", "label": "Phone number with country code", "default": "919999999999" },
    { "type": "text", "id": "message", "label": "Default message", "default": "Hi, I need help with my order." },
    { "type": "text", "id": "icon", "label": "Icon", "default": "💬" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Chat with us" },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "default": "right",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ]
    },
    { "type": "checkbox", "id": "show_text_mobile", "label": "Show text on mobile", "default": false },
    { "type": "color", "id": "background", "label": "Button background", "default": "#25D366" },
    { "type": "color", "id": "text_color", "label": "Button text color", "default": "#FFFFFF" },
    { "type": "range", "id": "bottom_spacing", "label": "Desktop bottom spacing", "min": 10, "max": 120, "step": 2, "default": 24 },
    { "type": "range", "id": "mobile_bottom_spacing", "label": "Mobile bottom spacing", "min": 10, "max": 120, "step": 2, "default": 24 }
  ]
}
{% endschema %}